generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Papel {
  ADMIN
  DIRETOR
  PROFESSOR
  ALUNO
}

enum CumprimentoClasses {
  SIM
  NAO
  ALGUMAS
}

enum SexoAluno {
  MASCULINO
  FEMININO
}

model Igreja {
  id              String           @id @default(uuid())
  nome            String
  distritoId      String?
  usuarios        Usuario[]
  unidades        UnidadeAcao[]
  cartoesDiretor  CartaoDiretor[]
  criadoEm        DateTime         @default(now())
}

model Usuario {
  id          String       @id @default(uuid())
  nome        String
  email       String       @unique
  senhaHash   String
  papel       Papel
  igrejaId    String
  distritoId  String?
  igreja      Igreja       @relation(fields: [igrejaId], references: [id])
  unidadesProfessor UnidadeAcao[] @relation("ProfessorUnidade")
  unidadesDiretor   UnidadeAcao[] @relation("DiretorUnidade")
  coletasProfessor  ColetaSemanalAluno[]
  coletasUnidadeProfessor ColetaSemanalProfessor[]
  aluno       Aluno?
  criadoEm    DateTime     @default(now())
}

model UnidadeAcao {
  id                 String             @id @default(uuid())
  nome               String
  igrejaId           String
  professorId        String?
  diretorId          String?
  ativa              Boolean            @default(true)
  igreja             Igreja             @relation(fields: [igrejaId], references: [id])
  professor          Usuario?           @relation("ProfessorUnidade", fields: [professorId], references: [id])
  diretor            Usuario?           @relation("DiretorUnidade", fields: [diretorId], references: [id])
  alunos             Aluno[]
  cartoesProfessor   CartaoProfessor[]
  coletasSemanais    ColetaSemanalAluno[]
  coletasProfessor   ColetaSemanalProfessor[]
}

model Aluno {
  id          String          @id @default(uuid())
  nome        String
  sexo        SexoAluno       @default(MASCULINO)
  fotoUrl     String?
  fotoPublicId String?
  dataNascimento DateTime?
  dataBatismo DateTime?
  endereco    String?
  email       String?
  whatsapp    String          @default("")
  unidadeId   String
  usuarioId   String?         @unique
  nivel       Int             @default(1)
  pontos      Int             @default(0)
  unidade     UnidadeAcao     @relation(fields: [unidadeId], references: [id])
  usuario     Usuario?        @relation(fields: [usuarioId], references: [id])
  cartoes     CartaoAluno[]
  coletasSemanais ColetaSemanalAluno[]
}

model ColetaSemanalAluno {
  id              String       @id @default(uuid())
  alunoId         String
  unidadeId       String
  professorId     String
  igrejaId        String
  distritoId      String?
  ano             Int
  numeroSemana    Int
  estudouLicao    Boolean      @default(false)
  foiPontual      Boolean      @default(false)
  pequenoGrupo    Boolean?
  acaoSolidaria   Boolean?
  acaoSolidariaDescricao String?
  acaoSolidariaTipo      String?
  estudosBiblicos Int?
  observacao      String?
  preenchidoEm    DateTime     @default(now())
  atualizadoEm    DateTime     @updatedAt
  aluno           Aluno        @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  unidade         UnidadeAcao  @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  professor       Usuario      @relation(fields: [professorId], references: [id])

  @@unique([alunoId, ano, numeroSemana])
  @@index([unidadeId, ano, numeroSemana])
  @@index([professorId, ano])
  @@index([igrejaId, ano])
}

model ColetaSemanalProfessor {
  id                         String       @id @default(uuid())
  unidadeId                  String
  professorId                String
  igrejaId                   String
  distritoId                 String?
  ano                        Int
  numeroSemana               Int
  participouPequenoGrupo     Boolean      @default(false)
  participouAcaoSolidaria    Boolean      @default(false)
  acaoSolidariaDescricao     String?
  acaoSolidariaTipo          String?
  ministrouEstudoBiblico     Boolean      @default(false)
  preenchidoEm               DateTime     @default(now())
  atualizadoEm               DateTime     @updatedAt
  unidade                    UnidadeAcao  @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  professor                  Usuario      @relation(fields: [professorId], references: [id])

  @@unique([unidadeId, ano, numeroSemana])
  @@index([professorId, ano])
  @@index([igrejaId, ano])
}

model CartaoAluno {
  id                       String               @id @default(uuid())
  alunoId                  String
  trimestre                Int
  ano                      Int
  pequenoGrupo             Boolean              @default(false)
  acaoSolidaria            Boolean              @default(false)
  acaoSolidariaDescricao   String?
  acaoSolidariaTipo        String?
  ministrouEstudoBiblico   Boolean              @default(false)
  aluno                    Aluno                @relation(fields: [alunoId], references: [id])
  sabados                  CartaoAlunoSabado[]

  @@unique([alunoId, trimestre, ano])
}

model CartaoAlunoSabado {
  id              String       @id @default(uuid())
  cartaoAlunoId   String
  numeroSabado    Int
  estudouSemana   Boolean      @default(false)
  pontual         Boolean      @default(false)
  cartaoAluno     CartaoAluno  @relation(fields: [cartaoAlunoId], references: [id], onDelete: Cascade)

  @@unique([cartaoAlunoId, numeroSabado])
}

model CartaoProfessor {
  id                         String                              @id @default(uuid())
  unidadeId                  String
  trimestre                  Int
  ano                        Int
  incentivaEstudo            Boolean                             @default(false)
  incentivaPontualidade      Boolean                             @default(false)
  visitouAlunos              Boolean                             @default(false)
  primeiraVisita             DateTime?
  ultimaVisita               DateTime?
  pequenoGrupoResponsavel    String?
  pequenoGrupoEndereco       String?
  pequenoGrupoDia            String?
  pequenoGrupoHorario        String?
  acaoSocialDescricao        String?
  acaoSocialTipo             String?
  acaoSocialData             DateTime?
  acaoSocialLocal            String?
  pessoasAlcancadas          Int                                  @default(0)
  interessadosAlcancados     Int                                  @default(0)
  batismos                   Int                                  @default(0)
  batismosNomes              String?
  planejamentoTrimestral     Boolean                              @default(false)
  promoveuConfraternizacao   Boolean                              @default(false)
  unidade                    UnidadeAcao                          @relation(fields: [unidadeId], references: [id])
  presencas                  CartaoProfessorPresenca[]
  estudosBiblicos            CartaoProfessorEstudoBiblico[]
  confraternizacoes          CartaoProfessorConfraternizacao[]

  @@unique([unidadeId, trimestre, ano])
}

model CartaoProfessorPresenca {
  id                  String            @id @default(uuid())
  cartaoProfessorId   String
  numeroSabado        Int
  presente            Boolean           @default(false)
  cartaoProfessor     CartaoProfessor   @relation(fields: [cartaoProfessorId], references: [id], onDelete: Cascade)

  @@unique([cartaoProfessorId, numeroSabado])
}

model CartaoProfessorEstudoBiblico {
  id                  String            @id @default(uuid())
  cartaoProfessorId   String
  alunoNome           String
  interessadoNome     String
  cartaoProfessor     CartaoProfessor   @relation(fields: [cartaoProfessorId], references: [id], onDelete: Cascade)
}

model CartaoProfessorConfraternizacao {
  id                  String            @id @default(uuid())
  cartaoProfessorId   String
  descricao           String
  data                DateTime
  cartaoProfessor     CartaoProfessor   @relation(fields: [cartaoProfessorId], references: [id], onDelete: Cascade)
}

model CartaoDiretor {
  id                              String               @id @default(uuid())
  igrejaId                        String
  trimestre                       Int
  ano                             Int
  cumprimentoClasses              CumprimentoClasses    @default(ALGUMAS)
  classeProfessoresFrequencia     String?
  classeProfessoresParticipantes  String?
  classeInteressadosImplantada    Boolean               @default(false)
  classeInteressadosQuantidade    Int                   @default(0)
  primeiraVisitaProfessores       DateTime?
  ultimaVisitaProfessores         DateTime?
  igreja                          Igreja                @relation(fields: [igrejaId], references: [id])

  @@unique([igrejaId, trimestre, ano])
}
